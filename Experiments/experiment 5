<body>

<div class="container">

    <div class="header">
        <div>
            <h1>Shopping Cart</h1>
            <p>Array Methods & Object Handling</p>
        </div>

        <div class="student">
            <strong>Nikita Punwatkar</strong><br>
            PRN: 24070521175
        </div>
    </div>

    <div class="card">
        <h2>Cart Items</h2>

        <div id="cart"></div>

        <button onclick="calculateTotal()">
            Calculate Total
        </button>

        <div id="result"></div>
    </div>

    <div class="card concepts">
        <strong>JavaScript Concepts:</strong><br><br>

        <code>map()</code> – displays cart items &nbsp; |
        <code>filter()</code> – filters items &nbsp; |
        <code>reduce()</code> – calculates total<br><br>

        <code>Objects</code> – stores product details &nbsp; |
        <code>Discount Logic</code> – applies discount based on total
    </div>

</div>


<script>

    // Array of objects
    const cart = [
        { name: "Wireless Headphones", price: 1200, quantity: 1 },
        { name: "Smart Watch", price: 2500, quantity: 1 },
        { name: "USB Cable", price: 300, quantity: 2 },
        { name: "Phone Stand", price: 500, quantity: 1 }
    ];


    // Display cart using map()
    document.getElementById("cart").innerHTML =
        cart.map(item => `
            <div class="cart-item">
                <span>
                    <strong>${item.name}</strong>
                    <br>
                    Qty: ${item.quantity}
                </span>

                <span class="price">
                    ₹${item.price * item.quantity}
                </span>
            </div>
        `).join("");


    function calculateTotal() {

        // reduce() calculates total
        let total = cart.reduce(
            (sum, item) =>
                sum + item.price * item.quantity, 0
        );


        // Discount logic
        let discount = total >= 4000 ? total * 0.10 : 0;

        let finalAmount = total - discount;


        document.getElementById("result").innerHTML = `
            <div class="summary">

                <div class="row">
                    <span>Subtotal</span>
                    <strong>₹${total}</strong>
                </div>

                <div class="row discount">
                    <span>Discount (10%)</span>
                    <strong>- ₹${discount}</strong>
                </div>

                <div class="row total">
                    <span>Final Total</span>
                    <span>₹${finalAmount}</span>
                </div>

            </div>
        `;
    }

</script>

</body>
