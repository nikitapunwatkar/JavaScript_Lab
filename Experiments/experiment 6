<body>

<div class="container">

    <div class="header">
        <div>
            <h1>String & Regex Analyzer</h1>
            <p>JavaScript String Functions and Regular Expressions</p>
        </div>

        <div class="student">
            Nikita Punwatkar<br>
            PRN: 24070521175
        </div>
    </div>


    <div class="card">

        <h2>Text Analysis</h2>

        <label>Enter Email</label>

        <input
            type="text"
            id="email"
            placeholder="example@gmail.com"
        >

        <label>Enter Text</label>

        <textarea
            id="text"
            placeholder="Example: My name is Nikita. I am learning JavaScript."
        ></textarea>

        <button onclick="analyze()">
            Analyze Text
        </button>

        <div id="result"></div>

    </div>

</div>


<script>

function analyze() {

    const email =
        document.getElementById("email").value.trim();

    const text =
        document.getElementById("text").value.trim();


    // Regular expression for email validation
    const emailRegex =
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const emailResult =
        emailRegex.test(email);


    // String functions
    const upper =
        text.toUpperCase();

    const lower =
        text.toLowerCase();

    const words =
        text.split(/\s+/).filter(Boolean);

    const wordCount =
        words.length;

    const charCount =
        text.length;


    // Regular expression for extracting numbers
    const numbers =
        text.match(/\d+/g) || [];


    // Extract capitalized words
    const capitalWords =
        text.match(/\b[A-Z][a-z]*\b/g) || [];


    document.getElementById("result").innerHTML = `

        <div class="result">

            <strong>Email Validation:</strong><br>

            <span class="${emailResult ? 'valid' : 'invalid'}">
                ${emailResult ? "✓ Valid Email" : "✗ Invalid Email"}
            </span>

            <hr>

            <strong>Text Analysis:</strong><br>

            Characters: ${charCount}<br>

            Words: ${wordCount}<br>

            Uppercase:
            ${upper}<br>

            Lowercase:
            ${lower}<br>

            Extracted Numbers:
            ${numbers.length ? numbers.join(", ") : "None"}<br>

            Extracted Capitalized Words:
            ${capitalWords.length ? capitalWords.join(", ") : "None"}

        </div>
    `;
}

</script>

</body>
</html>
