<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f6f7f3">
  <title>Daylight — your live weather dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      color-scheme: light;
      --ink: #26332e;
      --muted: #829089;
      --green: #51745e;
      --green-dark: #3d5d49;
      --paper: #f6f7f3;
      --card: #fff;
      --line: #e9ede8;
      --shadow: 0 16px 48px rgba(48, 69, 53, .07);
    }

    * { box-sizing: border-box; }

    body {
      min-width: 320px;
      margin: 0;
      background:
        radial-gradient(ellipse at 86% 9%, rgba(231, 239, 215, .72), transparent 30rem),
        var(--paper);
      color: var(--ink);
      font-family: "DM Sans", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    button, input { font: inherit; }
    button { color: inherit; }
    button:focus-visible, input:focus-visible {
      outline: 3px solid rgba(81, 116, 94, .36);
      outline-offset: 3px;
    }

    .shell { width: min(1120px, calc(100% - 48px)); margin: 0 auto; padding: 28px 0 46px; }
    .topbar, .brand, .top-actions, .location-line, .card-heading, .forecast-row, .hourly-row, .footer-note {
      display: flex;
      align-items: center;
    }
    .topbar { justify-content: space-between; margin-bottom: 43px; }
    .brand { gap: 11px; color: var(--ink); text-decoration: none; }
    .brand-mark {
      display: grid;
      width: 38px;
      height: 38px;
      place-items: center;
      border-radius: 13px;
      background: #e8efe2;
      color: var(--green);
      font-size: 17px;
    }
    .brand-name { font-family: Manrope, sans-serif; font-size: 18px; font-weight: 800; letter-spacing: -.7px; }
    .brand-tag { margin-left: 2px; color: var(--muted); font-size: 12px; }
    .top-actions { gap: 10px; }
    .icon-button, .unit-toggle {
      display: inline-flex;
      height: 42px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: rgba(255,255,255,.82);
      cursor: pointer;
      transition: border-color .2s, transform .2s, background .2s;
    }
    .icon-button { width: 42px; color: var(--green); }
    .icon-button:hover, .unit-toggle:hover { transform: translateY(-1px); border-color: #ccd9cb; }
    .icon-button.is-active { color: #d77867; }
    .unit-toggle { gap: 2px; padding: 4px; }
    .unit-toggle button {
      width: 31px;
      height: 31px;
      border: 0;
      border-radius: 9px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
    }
    .unit-toggle button.active { background: #eaf0e7; color: var(--green-dark); }

    .intro { margin-bottom: 23px; }
    .eyebrow { margin: 0 0 8px; color: var(--green); font-size: 11px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; }
    h1, h2, p { margin-top: 0; }
    h1 { margin-bottom: 8px; font-family: Manrope, sans-serif; font-size: clamp(29px, 4vw, 39px); font-weight: 700; letter-spacing: -1.7px; }
    .subheading { margin-bottom: 0; color: var(--muted); font-size: 14px; }

    .search-row { display: flex; gap: 11px; margin: 23px 0 24px; }
    .search-box {
      display: flex;
      width: min(420px, 100%);
      height: 48px;
      align-items: center;
      gap: 11px;
      padding: 0 15px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fff;
      color: #95a198;
      transition: box-shadow .2s, border-color .2s;
    }
    .search-box:focus-within { border-color: #bacbb8; box-shadow: 0 0 0 4px rgba(81, 116, 94, .08); }
    .search-box input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: 13px; }
    .search-box input::placeholder { color: #a4aea7; }
    .search-button {
      height: 48px;
      padding: 0 20px;
      border: 0;
      border-radius: 14px;
      background: var(--green);
      color: white;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
      transition: background .2s, transform .2s;
    }
    .search-button:hover { transform: translateY(-1px); background: var(--green-dark); }
    .quick-cities { display: flex; align-items: center; gap: 8px; overflow-x: auto; padding-bottom: 5px; }
    .quick-label { flex: 0 0 auto; margin-right: 3px; color: var(--muted); font-size: 12px; }
    .city-chip {
      flex: 0 0 auto;
      padding: 7px 12px;
      border: 1px solid #e8ece6;
      border-radius: 999px;
      background: rgba(255,255,255,.64);
      color: #637168;
      cursor: pointer;
      font-size: 11px;
      transition: all .2s;
    }
    .city-chip:hover, .city-chip.active { border-color: #cbd9c9; background: #edf2e9; color: var(--green-dark); }

    .status-message { min-height: 20px; margin: 12px 0 0; color: var(--muted); font-size: 12px; }
    .status-message.error { color: #bd5a4d; }

    .dashboard { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(270px, .9fr); gap: 18px; }
    .card { border: 1px solid rgba(230,235,228,.85); border-radius: 22px; background: var(--card); box-shadow: var(--shadow); }
    .current-card {
      position: relative;
      min-height: 288px;
      overflow: hidden;
      padding: 26px 28px;
      background: linear-gradient(118deg, #fff 4%, #fff 50%, #f7f9ef 100%);
    }
    .location-line { gap: 8px; color: var(--muted); font-size: 12px; }
    .location-line i { color: var(--green); font-size: 11px; }
    .location-name { color: var(--ink); font-size: 14px; font-weight: 700; }
    .current-time { margin-left: 3px; color: #9aa59e; font-size: 11px; }
    .current-content { display: flex; align-items: center; justify-content: space-between; padding-top: 30px; }
    .temperature { display: flex; align-items: flex-start; font-family: Manrope, sans-serif; font-size: clamp(68px, 9vw, 96px); font-weight: 600; letter-spacing: -8px; line-height: .96; }
    .temperature-unit { margin: 10px 0 0 7px; font-size: 27px; font-weight: 500; letter-spacing: -1px; }
    .condition { margin: 14px 0 0 5px; color: #75827a; font-size: 14px; }
    .feels-like { margin: 6px 0 0 5px; color: #a0aaa3; font-size: 11px; }
    .weather-art { position: relative; display: grid; width: 175px; height: 160px; flex: 0 0 175px; place-items: center; margin: 0 22px 2px 0; }
    .sun-glow { position: absolute; width: 144px; height: 144px; border-radius: 50%; background: radial-gradient(circle, rgba(247,211,119,.24), rgba(247,211,119,0) 69%); }
    .sun-disc { position: absolute; top: 17px; right: 24px; width: 78px; height: 78px; border-radius: 50%; background: linear-gradient(145deg, #f8d77f, #f0bd62); box-shadow: 0 8px 26px rgba(231,184,90,.18); }
    .weather-art.is-night .sun-disc { background: linear-gradient(145deg, #e4e9ef, #c2cedb); box-shadow: 0 8px 26px rgba(111,132,153,.18); }
    .cloud { position: absolute; right: 15px; bottom: 30px; z-index: 1; width: 125px; height: 43px; border-radius: 99px; background: linear-gradient(180deg, #fff, #edf2ec); box-shadow: 0 10px 24px rgba(74,95,78,.1); }
    .cloud::before, .cloud::after { position: absolute; bottom: 13px; border-radius: 50%; background: #f7f9f5; content: ""; }
    .cloud::before { left: 23px; width: 48px; height: 48px; }
    .cloud::after { right: 18px; width: 37px; height: 37px; }
    .art-rain .cloud { background: linear-gradient(180deg, #e0e9e3, #c8d6cd); }
    .art-rain .cloud::before, .art-rain .cloud::after { background: #d6e0d8; }
    .rain { position: absolute; right: 32px; bottom: 12px; z-index: 2; display: flex; gap: 22px; }
    .rain span { width: 3px; height: 14px; transform: rotate(20deg); border-radius: 3px; background: #9dc5c2; }

    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 17px; }
    .stat-card { min-height: 98px; padding: 17px 18px; box-shadow: none; }
    .stat-label { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; color: var(--muted); font-size: 11px; }
    .stat-label i { color: #91a28e; font-size: 12px; }
    .stat-value { font-family: Manrope, sans-serif; font-size: 19px; font-weight: 700; letter-spacing: -.5px; }
    .stat-value small { margin-left: 3px; color: var(--muted); font-family: "DM Sans", sans-serif; font-size: 11px; font-weight: 500; }
    .side-column { display: flex; flex-direction: column; gap: 17px; }
    .sun-card { min-height: 183px; padding: 21px 22px; }
    .card-heading { justify-content: space-between; margin-bottom: 16px; }
    .card-heading h2 { margin: 0; font-family: Manrope, sans-serif; font-size: 14px; font-weight: 700; letter-spacing: -.3px; }
    .card-kicker { color: #a1aaa2; font-size: 10px; }
    .sun-times { display: flex; justify-content: space-between; margin-bottom: 11px; }
    .sun-time { color: var(--muted); font-size: 10px; }
    .sun-time strong { display: block; margin-top: 4px; color: var(--ink); font-size: 14px; font-weight: 700; }
    .sun-track { position: relative; height: 43px; overflow: hidden; }
    .sun-track::before { position: absolute; right: 6px; bottom: -34px; left: 6px; height: 69px; border: 1px solid #e6e9d8; border-bottom: 0; border-radius: 100% 100% 0 0; content: ""; }
    .sun-track::after { position: absolute; bottom: 0; left: 8%; width: 84%; height: 1px; background: linear-gradient(90deg, #f2d189, #e8e9da 50%, #f2d189); content: ""; }
    .sun-dot { position: absolute; bottom: 11px; left: 49%; z-index: 1; width: 10px; height: 10px; border-radius: 50%; background: #efc66c; box-shadow: 0 0 0 4px rgba(239,198,108,.18); }
    .forecast-card { flex: 1; padding: 21px 22px 16px; }
    .forecast-list { display: flex; flex-direction: column; }
    .forecast-row { min-height: 41px; justify-content: space-between; border-top: 1px solid #f0f2ee; color: #738078; font-size: 11px; }
    .forecast-day { width: 65px; color: var(--ink); font-weight: 600; }
    .forecast-icon { width: 25px; color: #b8a566; text-align: center; }
    .forecast-rain { width: 46px; color: #94aeac; text-align: center; }
    .forecast-range { display: flex; width: 87px; justify-content: flex-end; gap: 10px; color: #a4ada6; }
    .forecast-range strong { color: #4a594f; font-weight: 700; }
    .hourly-card { margin-top: 18px; padding: 21px 24px 23px; }
    .hourly-row { justify-content: space-between; gap: 13px; overflow-x: auto; padding: 2px 1px 5px; }
    .hour { display: flex; min-width: 53px; flex-direction: column; align-items: center; gap: 11px; color: #929e95; font-size: 10px; }
    .hour i { color: #d4ae5e; font-size: 15px; }
    .hour strong { color: var(--ink); font-size: 12px; font-weight: 700; }
    .hour .rain-chance { margin-top: -6px; color: #95b6b1; font-size: 9px; }
    .skeleton { color: transparent !important; border-radius: 5px; background: #edf0eb !important; animation: pulse 1.2s ease-in-out infinite alternate; }
    @keyframes pulse { to { opacity: .48; } }
    .footer-note { justify-content: space-between; gap: 12px; margin-top: 19px; color: #a1aaa3; font-size: 10px; }
    .footer-note a { color: var(--green); text-decoration: none; }
    .footer-note a:hover { text-decoration: underline; }
    .footer-brand { display: flex; align-items: center; gap: 6px; white-space: nowrap; }
    .footer-brand i { color: #89a087; font-size: 9px; }

    @media (max-width: 760px) {
      .shell { width: min(100% - 32px, 560px); padding-top: 20px; }
      .topbar { margin-bottom: 33px; }
      .brand-tag { display: none; }
      .dashboard { grid-template-columns: 1fr; }
      .side-column { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; }
      .sun-card { min-height: 175px; }
      .forecast-card { grid-row: span 2; }
    }
    @media (max-width: 520px) {
      .shell { width: calc(100% - 28px); }
      .search-row { gap: 8px; }
      .search-button { padding: 0 15px; }
      .current-card { min-height: 265px; padding: 22px 20px; }
      .current-content { padding-top: 34px; }
      .temperature { font-size: 74px; }
      .weather-art { width: 125px; height: 135px; flex-basis: 125px; margin-right: 0; transform: scale(.83); transform-origin: center right; }
      .stats-grid { gap: 8px; }
      .stat-card { min-height: 92px; padding: 13px 10px; }
      .stat-label { gap: 5px; font-size: 10px; }
      .stat-value { font-size: 17px; }
      .side-column { grid-template-columns: 1fr; }
      .forecast-card { grid-row: auto; }
      .sun-card { min-height: 160px; }
      .footer-note { align-items: flex-start; flex-direction: column; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="#" aria-label="Daylight home">
        <span class="brand-mark"><i class="fa-solid fa-sun"></i></span>
        <span class="brand-name">daylight</span>
        <span class="brand-tag">a little closer to the sky</span>
      </a>
      <div class="top-actions">
        <button class="icon-button" id="refreshButton" type="button" aria-label="Refresh weather" title="Refresh weather">
          <i class="fa-solid fa-rotate-right"></i>
        </button>
        <div class="unit-toggle" role="group" aria-label="Temperature unit">
          <button type="button" data-unit="celsius" class="active" aria-pressed="true">°C</button>
          <button type="button" data-unit="fahrenheit" aria-pressed="false">°F</button>
        </div>
        <button class="icon-button" id="favoriteButton" type="button" aria-label="Save this city" title="Save this city">
          <i class="fa-regular fa-heart"></i>
        </button>
      </div>
    </header>

    <main>
      <section class="intro" aria-labelledby="pageTitle">
        <p class="eyebrow">Your daily forecast</p>
        <h1 id="pageTitle">Find your kind of weather.</h1>
        <p class="subheading">A little sunshine, a little rain — know what's waiting outside.</p>
      </section>

      <form class="search-row" id="searchForm" role="search">
        <label class="search-box">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input id="cityInput" name="city" type="search" placeholder="Search any city..." autocomplete="off" aria-label="Search any city">
        </label>
        <button class="search-button" type="submit">Search</button>
      </form>

      <nav class="quick-cities" aria-label="Popular cities">
        <span class="quick-label">Popular:</span>
        <button class="city-chip" type="button" data-city="London">London</button>
        <button class="city-chip" type="button" data-city="Tokyo">Tokyo</button>
        <button class="city-chip" type="button" data-city="New York">New York</button>
        <button class="city-chip" type="button" data-city="Mumbai">Mumbai</button>
        <button class="city-chip" type="button" data-city="Sydney">Sydney</button>
      </nav>
      <p class="status-message" id="statusMessage" role="status" aria-live="polite"></p>

      <section class="dashboard" aria-label="Weather dashboard">
        <div>
          <article class="card current-card">
            <div class="location-line">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span class="location-name" id="locationName">London</span>
              <span class="current-time" id="currentTime">Local time</span>
            </div>
            <div class="current-content">
              <div>
                <div class="temperature"><span id="currentTemperature" class="skeleton">--</span><span class="temperature-unit" id="temperatureUnit">°C</span></div>
                <p class="condition" id="weatherDescription">Checking the skies...</p>
                <p class="feels-like" id="feelsLike">Feels like --°</p>
              </div>
              <div class="weather-art" id="weatherArt" aria-hidden="true">
                <div class="sun-glow"></div><div class="sun-disc"></div><div class="cloud"></div>
              </div>
            </div>
          </article>

          <div class="stats-grid">
            <article class="card stat-card">
              <div class="stat-label"><i class="fa-solid fa-droplet"></i> Humidity</div>
              <div class="stat-value" id="humidityValue">--<small>%</small></div>
            </article>
            <article class="card stat-card">
              <div class="stat-label"><i class="fa-solid fa-wind"></i> Wind speed</div>
              <div class="stat-value" id="windValue">--<small>km/h</small></div>
            </article>
            <article class="card stat-card">
              <div class="stat-label"><i class="fa-solid fa-umbrella"></i> Rain chance</div>
              <div class="stat-value" id="rainValue">--<small>%</small></div>
            </article>
          </div>
        </div>

        <aside class="side-column">
          <article class="card sun-card">
            <div class="card-heading">
              <h2>Sunrise & sunset</h2>
              <span class="card-kicker" id="sunDay">TODAY</span>
            </div>
            <div class="sun-times">
              <div class="sun-time"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> Sunrise<strong id="sunriseTime">--:--</strong></div>
              <div class="sun-time"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i> Sunset<strong id="sunsetTime">--:--</strong></div>
            </div>
            <div class="sun-track" aria-hidden="true"><span class="sun-dot"></span></div>
          </article>
          <article class="card forecast-card">
            <div class="card-heading">
              <h2>Next 5 days</h2>
              <span class="card-kicker">OUTLOOK</span>
            </div>
            <div class="forecast-list" id="forecastList" aria-label="Five day forecast">
              <div class="forecast-row"><span class="forecast-day skeleton">Loading</span><span> </span><span> </span></div>
            </div>
          </article>
        </aside>
      </section>

      <section class="card hourly-card" aria-labelledby="hourlyTitle">
        <div class="card-heading">
          <h2 id="hourlyTitle">The next few hours</h2>
          <span class="card-kicker">HOURLY</span>
        </div>
        <div class="hourly-row" id="hourlyForecast" aria-label="Hourly forecast"></div>
      </section>
    </main>

    <footer class="footer-note">
      <span>Weather updates automatically every 10 minutes · Temperatures shown in <span id="footerUnit">°C</span></span>
      <span class="footer-brand"><i class="fa-solid fa-heart"></i> Weather data by <a href="https://open-meteo.com/" target="_blank" rel="noreferrer">Open-Meteo</a></span>
    </footer>
  </div>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script>
    $(function () {
      const STORAGE_KEYS = {
        city: "daylight-city",
        unit: "daylight-unit",
        favorites: "daylight-favorites"
      };
      const weatherDescriptions = {
        0: ["Clear sky", "fa-sun"],
        1: ["Mostly clear", "fa-cloud-sun"],
        2: ["Partly cloudy", "fa-cloud-sun"],
        3: ["Overcast", "fa-cloud"],
        45: ["Foggy", "fa-smog"],
        48: ["Foggy", "fa-smog"],
        51: ["Light drizzle", "fa-cloud-rain"],
        53: ["Drizzle", "fa-cloud-rain"],
        55: ["Heavy drizzle", "fa-cloud-showers-heavy"],
        56: ["Freezing drizzle", "fa-cloud-rain"],
        57: ["Freezing drizzle", "fa-cloud-rain"],
        61: ["Light rain", "fa-cloud-rain"],
        63: ["Rain", "fa-cloud-rain"],
        65: ["Heavy rain", "fa-cloud-showers-heavy"],
        66: ["Freezing rain", "fa-cloud-rain"],
        67: ["Freezing rain", "fa-cloud-rain"],
        71: ["Light snow", "fa-snowflake"],
        73: ["Snow", "fa-snowflake"],
        75: ["Heavy snow", "fa-snowflake"],
        77: ["Snow grains", "fa-snowflake"],
        80: ["Rain showers", "fa-cloud-showers-heavy"],
        81: ["Rain showers", "fa-cloud-showers-heavy"],
        82: ["Heavy showers", "fa-cloud-showers-heavy"],
        85: ["Snow showers", "fa-snowflake"],
        86: ["Heavy snow showers", "fa-snowflake"],
        95: ["Thunderstorm", "fa-cloud-bolt"],
        96: ["Thunderstorm & hail", "fa-cloud-bolt"],
        99: ["Thunderstorm & hail", "fa-cloud-bolt"]
      };
      const defaultCity = { name: "London", country: "United Kingdom", latitude: 51.5072, longitude: -0.1276, timezone: "Europe/London" };
      let selectedCity = readStoredCity() || defaultCity;
      let weatherData = null;
      let unit = localStorage.getItem(STORAGE_KEYS.unit) === "fahrenheit" ? "fahrenheit" : "celsius";
      let requestId = 0;
      let searchRequestId = 0;
      let refreshTimer;

      function readStoredCity() {
        try {
          const city = JSON.parse(localStorage.getItem(STORAGE_KEYS.city));
          if (city && typeof city.name === "string" && Number.isFinite(city.latitude) && Number.isFinite(city.longitude)) return city;
        } catch (error) {
          console.warn("Could not read the saved city preference.", error);
        }
        return null;
      }

      function getFavorites() {
        try {
          const favorites = JSON.parse(localStorage.getItem(STORAGE_KEYS.favorites));
          return Array.isArray(favorites) ? favorites.filter((name) => typeof name === "string") : [];
        } catch (error) {
          console.warn("Could not read saved favorite cities.", error);
          return [];
        }
      }

      function saveCity(city) {
        selectedCity = city;
        try {
          localStorage.setItem(STORAGE_KEYS.city, JSON.stringify(city));
        } catch (error) {
          console.error("Could not save the selected city.", error);
          setStatus("Your browser couldn't save this city preference.", true);
        }
      }

      function setStatus(message, isError) {
        $("#statusMessage").text(message).toggleClass("error", Boolean(isError));
      }

      function temperature(value) {
        if (!Number.isFinite(value)) return "--";
        const converted = unit === "fahrenheit" ? value * 9 / 5 + 32 : value;
        return Math.round(converted);
      }

      function unitSymbol() {
        return unit === "fahrenheit" ? "°F" : "°C";
      }

      function getWeatherInfo(code) {
        return weatherDescriptions[code] || ["Weather conditions", "fa-cloud"];
      }

      function formatClock(date, timezone) {
        return new Intl.DateTimeFormat("en", { hour: "numeric", minute: "2-digit", timeZone: timezone }).format(date);
      }

      function formatHour(timestamp) {
        return new Intl.DateTimeFormat("en", { hour: "numeric", timeZone: "UTC" }).format(new Date(timestamp + "Z"));
      }

      function formatDay(dateString) {
        const date = new Date(dateString + "T12:00:00Z");
        return new Intl.DateTimeFormat("en", { weekday: "short", timeZone: "UTC" }).format(date);
      }

      function formatSolarTime(value) {
        const hour = Number(value.slice(11, 13));
        const minute = Number(value.slice(14, 16));
        return new Intl.DateTimeFormat("en", { hour: "numeric", minute: "2-digit", timeZone: "UTC" })
          .format(new Date(Date.UTC(2000, 0, 1, hour, minute)));
      }

      function updateClock() {
        if (selectedCity.timezone) {
          $("#currentTime").text("· " + formatClock(new Date(), selectedCity.timezone));
        }
      }

      function setLoading(isLoading) {
        $("#refreshButton").prop("disabled", isLoading).toggleClass("is-loading", isLoading);
        $("#refreshButton i").toggleClass("fa-spin", isLoading);
        $("#currentTemperature").toggleClass("skeleton", isLoading);
      }

      function loadWeather(city) {
        const currentRequest = ++requestId;
        saveCity(city);
        $("#locationName").text(city.name + (city.country ? ", " + city.country : ""));
        $(".city-chip").each(function () {
          $(this).toggleClass("active", $(this).data("city").toLowerCase() === city.name.toLowerCase());
        });
        setStatus("Finding the latest forecast for " + city.name + "…", false);
        setLoading(true);
        $.ajax({
          url: "https://api.open-meteo.com/v1/forecast",
          method: "GET",
          dataType: "json",
          timeout: 12000,
          data: {
            latitude: city.latitude,
            longitude: city.longitude,
            current: "temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m",
            hourly: "temperature_2m,precipitation_probability,weather_code",
            daily: "weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,uv_index_max,precipitation_probability_max",
            wind_speed_unit: "kmh",
            timezone: city.timezone || "auto",
            forecast_days: 6
          }
        }).done(function (data) {
          if (currentRequest !== requestId) return;
          weatherData = data;
          selectedCity.timezone = data.timezone || selectedCity.timezone;
          renderWeather(data);
          updateClock();
          setStatus("Forecast updated just now.", false);
        }).fail(function (xhr, textStatus) {
          if (currentRequest !== requestId) return;
          const message = textStatus === "timeout"
            ? "The weather service took too long to respond. Try again."
            : "Couldn't load the forecast. Check your connection and try again.";
          setStatus(message, true);
          $("#weatherDescription").text("Forecast unavailable");
        }).always(function () {
          if (currentRequest === requestId) setLoading(false);
        });
      }

      function renderWeather(data) {
        const current = data.current;
        const info = getWeatherInfo(current.weather_code);
        const todayIndex = Math.max(0, data.daily.time.indexOf(current.time.slice(0, 10)));
        const nextHour = Math.max(0, data.hourly.time.findIndex((time) => time >= current.time));
        const rainChance = data.hourly.precipitation_probability[nextHour] ?? data.daily.precipitation_probability_max[todayIndex];
        const isDay = current.is_day === 1;

        $("#currentTemperature").text(temperature(current.temperature_2m)).removeClass("skeleton");
        $("#temperatureUnit, #footerUnit").text(unitSymbol());
        $("#weatherDescription").text(info[0]);
        $("#feelsLike").text("Feels like " + temperature(current.apparent_temperature) + unitSymbol());
        $("#humidityValue").html(Math.round(current.relative_humidity_2m) + "<small>%</small>");
        $("#windValue").html(Math.round(current.wind_speed_10m) + "<small>km/h</small>");
        $("#rainValue").html(Math.round(rainChance || 0) + "<small>%</small>");
        $("#sunriseTime").text(formatSolarTime(data.daily.sunrise[todayIndex]));
        $("#sunsetTime").text(formatSolarTime(data.daily.sunset[todayIndex]));
        $("#sunDay").text(isDay ? "DAYTIME" : "TONIGHT");
        $("#weatherArt").toggleClass("art-rain", [51, 53, 55, 61, 63, 65, 80, 81, 82].includes(current.weather_code));
        $("#weatherArt .sun-disc").toggleClass("moon", !isDay).toggle(isDay || [0, 1, 2].includes(current.weather_code));
        $("#weatherArt .sun-glow").toggle(isDay);
        $("#weatherArt .cloud").toggle(current.weather_code !== 0);
        $("#weatherArt").toggleClass("is-night", !isDay);
        if ([51, 53, 55, 61, 63, 65, 80, 81, 82].includes(current.weather_code)) {
          $("#weatherArt .rain").remove();
          $("#weatherArt").append('<div class="rain"><span></span><span></span><span></span></div>');
        } else {
          $("#weatherArt .rain").remove();
        }
        renderHourly(data, nextHour);
        renderDaily(data, todayIndex);
        updateFavoriteButton();
      }

      function renderHourly(data, startIndex) {
        let markup = "";
        for (let offset = 0; offset < 6; offset += 1) {
          const index = startIndex + offset;
          if (index >= data.hourly.time.length) break;
          const description = getWeatherInfo(data.hourly.weather_code[index]);
          const hourLabel = offset === 0 ? "Now" : formatHour(data.hourly.time[index]);
          markup += '<div class="hour"><span>' + hourLabel + '</span><i class="fa-solid ' + description[1] + '" aria-hidden="true"></i><strong>' +
            temperature(data.hourly.temperature_2m[index]) + unitSymbol() + '</strong><span class="rain-chance"><i class="fa-solid fa-droplet" aria-hidden="true"></i> ' +
            Math.round(data.hourly.precipitation_probability[index] || 0) + '%</span></div>';
        }
        $("#hourlyForecast").html(markup);
      }

      function renderDaily(data, todayIndex) {
        let markup = "";
        for (let offset = 1; offset <= 5; offset += 1) {
          const index = todayIndex + offset;
          if (index >= data.daily.time.length) break;
          const description = getWeatherInfo(data.daily.weather_code[index]);
          markup += '<div class="forecast-row"><span class="forecast-day">' + formatDay(data.daily.time[index]) +
            '</span><span class="forecast-icon"><i class="fa-solid ' + description[1] + '" aria-hidden="true"></i></span>' +
            '<span class="forecast-rain"><i class="fa-solid fa-droplet" aria-hidden="true"></i> ' +
            Math.round(data.daily.precipitation_probability_max[index] || 0) + '%</span><span class="forecast-range"><span>' +
            temperature(data.daily.temperature_2m_min[index]) + '°</span><strong>' + temperature(data.daily.temperature_2m_max[index]) + '°</strong></span></div>';
        }
        $("#forecastList").html(markup || '<p class="status-message">No daily forecast available.</p>');
      }

      function updateFavoriteButton() {
        const isFavorite = getFavorites().some((name) => name.toLowerCase() === selectedCity.name.toLowerCase());
        $("#favoriteButton").toggleClass("is-active", isFavorite)
          .attr("aria-pressed", String(isFavorite))
          .attr("aria-label", isFavorite ? "Remove " + selectedCity.name + " from saved cities" : "Save " + selectedCity.name);
        $("#favoriteButton i").toggleClass("fa-solid", isFavorite).toggleClass("fa-regular", !isFavorite);
      }

      function searchCity(query) {
        const cityName = query.trim();
        if (!cityName) {
          setStatus("Type a city name to search.", true);
          $("#cityInput").trigger("focus");
          return;
        }
        const currentSearch = ++searchRequestId;
        requestId += 1;
        setLoading(false);
        setStatus("Searching for " + cityName + "…", false);
        $.ajax({
          url: "https://geocoding-api.open-meteo.com/v1/search",
          method: "GET",
          dataType: "json",
          timeout: 10000,
          data: { name: cityName, count: 1, language: "en", format: "json" }
        }).done(function (data) {
          if (currentSearch !== searchRequestId) return;
          if (!data.results || !data.results.length) {
            setStatus("No city found for “" + cityName + "”. Try another name.", true);
            return;
          }
          const result = data.results[0];
          loadWeather({
            name: result.name,
            country: result.country || result.admin1 || "",
            latitude: result.latitude,
            longitude: result.longitude,
            timezone: result.timezone
          });
          $("#cityInput").val("");
        }).fail(function (xhr, textStatus) {
          if (currentSearch !== searchRequestId) return;
          if (textStatus === "abort") return;
          setStatus("City search failed. Check your connection and try again.", true);
        });
      }

      $("#searchForm").on("submit", function (event) {
        event.preventDefault();
        searchCity($("#cityInput").val());
      });

      $(".quick-cities").on("click", ".city-chip", function () {
        searchCity($(this).data("city"));
      });

      $("#refreshButton").on("click", function () {
        loadWeather(selectedCity);
      });

      $(".unit-toggle").on("click", "button", function () {
        const nextUnit = $(this).data("unit");
        if (nextUnit === unit) return;
        unit = nextUnit;
        localStorage.setItem(STORAGE_KEYS.unit, unit);
        $(".unit-toggle button").removeClass("active").attr("aria-pressed", "false");
        $(this).addClass("active").attr("aria-pressed", "true");
        if (weatherData) {
          renderWeather(weatherData);
          $("#footerUnit").text(unitSymbol());
        } else {
          loadWeather(selectedCity);
        }
      });

      $("#favoriteButton").on("click", function () {
        const favorites = getFavorites();
        const index = favorites.findIndex((name) => name.toLowerCase() === selectedCity.name.toLowerCase());
        if (index >= 0) favorites.splice(index, 1);
        else favorites.push(selectedCity.name);
        try {
          localStorage.setItem(STORAGE_KEYS.favorites, JSON.stringify(favorites));
          updateFavoriteButton();
          setStatus(index >= 0 ? "Removed from your saved cities." : "City saved to your favorites.", false);
        } catch (error) {
          console.error("Could not update saved cities.", error);
          setStatus("Your browser couldn't save this favorite.", true);
        }
      });

      $(".unit-toggle button").removeClass("active").attr("aria-pressed", "false")
        .filter('[data-unit="' + unit + '"]').addClass("active").attr("aria-pressed", "true");
      loadWeather(selectedCity);
      updateClock();
      setInterval(updateClock, 30000);
      refreshTimer = setInterval(function () { loadWeather(selectedCity); }, 10 * 60 * 1000);
      $(window).on("beforeunload", function () { clearInterval(refreshTimer); });
    });
  </script>
</body>
</html>
