<script>

const url =
    "https://jsonplaceholder.typicode.com/users";


// Display JSON data in table
function displayData(data) {

    let rows = "";

    data.forEach(user => {

        rows += `
            <tr>
                <td>${user.id}</td>
                <td>${user.name}</td>
                <td>${user.username}</td>
                <td>${user.email}</td>
                <td>${user.address.city}</td>
            </tr>
        `;

    });

    document.querySelector("#dataTable tbody").innerHTML = rows;
}


// Using fetch()
async function loadFetch() {

    try {

        const response = await fetch(url);
        const data = await response.json();

        displayData(data);

        document.getElementById("status").textContent =
            "✓ Data loaded using fetch()";

    } catch (error) {

        document.getElementById("status").textContent =
            "Error loading data.";

    }
}


// Using jQuery $.getJSON()
function loadJQuery() {

    $.getJSON(url)
        .done(function(data) {

            displayData(data);

            document.getElementById("status").textContent =
                "✓ Data loaded using jQuery $.getJSON()";

        })
        .fail(function() {

            document.getElementById("status").textContent =
                "Error loading data.";

        });
}

</script>

</body>
</html>
