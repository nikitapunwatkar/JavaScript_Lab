<body>

<div class="container">

    <div class="header">
        <div>
            <h1>JSON Data Viewer</h1>
            <p>Fetch API & jQuery $.getJSON()</p>
        </div>

        <div class="student">
            Nikita Punwatkar<br>
            PRN: 24070521175
        </div>
    </div>


    <div class="card">

        <h2>Load JSON Data</h2>

        <button onclick="loadFetch()">
            Load using fetch()
        </button>

        <button class="jquery" onclick="loadJQuery()">
            Load using $.getJSON()
        </button>

        <div id="status"></div>

        <div class="table-box">
            <table id="dataTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>City</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td colspan="5">
                            Click a button to load data
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

