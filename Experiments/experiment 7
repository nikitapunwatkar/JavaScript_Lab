        </div>
    </div>


    <div class="card">

        <h2>Add a Task</h2>

        <div class="input-box">

            <input
                type="text"
                id="taskInput"
                placeholder="Enter your task..."
            >

            <button class="add-btn" onclick="addTask()">
                Add Task
            </button>

        </div>


        <ul id="taskList">

            <li class="empty">
                No tasks added yet.
            </li>

        </ul>

    </div>


    <div class="card concepts">

        <strong>DOM Concepts Demonstrated</strong><br>

        <code>createElement()</code> – creates new elements<br>

        <code>appendChild()</code> – adds elements to the DOM<br>

        <code>parentElement</code> – traverses to parent element<br>

        <code>remove()</code> – deletes an element<br>

        <code>textContent</code> – modifies element content<br>

        <code>prompt()</code> – edits an existing task

    </div>

</div>


<script>

function addTask() {

    const input =
        document.getElementById("taskInput");

    const list =
        document.getElementById("taskList");

    const task =
        input.value.trim();

    if (task === "") {
        alert("Please enter a task.");
        return;
    }


    // Remove "No tasks" message
    const empty =
        document.querySelector(".empty");

    if (empty) {
        empty.remove();
    }


    // Create new list item
    const li =
        document.createElement("li");


    // Create task text
    const span =
        document.createElement("span");

    span.textContent = task;


    // Edit button
    const edit =
        document.createElement("button");

    edit.textContent = "Edit";
    edit.className = "edit";


    // Edit functionality
    edit.onclick = function() {

        const newTask =
            prompt("Edit your task:", span.textContent);

        if (newTask && newTask.trim() !== "") {
            span.textContent = newTask.trim();
        }
    };


    // Delete button
    const del =
        document.createElement("button");

    del.textContent = "Delete";
    del.className = "delete";


    // Delete functionality
    del.onclick = function() {

        li.remove();

        if (list.children.length === 0) {

            list.innerHTML =
                `<li class="empty">
                    No tasks added yet.
                </li>`;
        }
    };


    // Add elements to list item
    li.appendChild(span);
    li.appendChild(edit);
    li.appendChild(del);

    // Add list item to DOM
    list.appendChild(li);


    // Clear input
    input.value = "";
    input.focus();
}

</script>

</body>
