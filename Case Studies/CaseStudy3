<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Palindrome Checker</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #ecfeff, #f0fdf4);
      margin: 0;
      padding: 0;
      color: #111827;
    }

    .container {
      max-width: 700px;
      margin: 40px auto;
      background: white;
      padding: 24px;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    h1 {
      color: #0f766e;
      margin-top: 0;
    }

    form {
      display: grid;
      gap: 12px;
    }

    label {
      display: flex;
      flex-direction: column;
      font-weight: bold;
      gap: 6px;
    }

    input {
      padding: 10px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 15px;
    }

    button {
      padding: 12px 16px;
      border: none;
      border-radius: 8px;
      background: #0f766e;
      color: white;
      font-size: 16px;
      cursor: pointer;
      margin-top: 8px;
    }

    button:hover {
      background: #115e59;
    }

    .message {
      margin-top: 16px;
      padding: 14px;
      border-radius: 8px;
      font-weight: bold;
    }

    .success {
      background: #dcfce7;
      color: #166534;
    }

    .error {
      background: #fee2e2;
      color: #b91c1c;
    }

    .notes {
      margin-top: 20px;
      background: #f8fafc;
      padding: 14px;
      border-radius: 8px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Palindrome Checker</h1>
    <p>Enter a word or phrase to check whether it is a palindrome.</p>

    <form id="palindromeForm">
      <label>
        Text
        <input id="textInput" type="text" placeholder="Enter text here" />
      </label>
      <button type="button" id="checkBtn">Check Palindrome</button>
    </form>

    <div id="messageBox" class="message">Your result will appear here.</div>

    <div class="notes">
      <h3>JavaScript concepts used</h3>
      <ul>
        <li><strong>Functions</strong>: used to process the input</li>
        <li><strong>Scope</strong>: variables are kept inside the function where needed</li>
        <li><strong>Closures</strong>: a function remembers the text it checks</li>
        <li><strong>try-catch</strong>: used to handle invalid input safely</li>
      </ul>
    </div>
  </div>

  <script>
    function normalizeText(text) {
      return text.toLowerCase().replace(/[^a-z0-9]/g, "");
    }

    function isPalindrome(text) {
      const cleanedText = normalizeText(text);
      const reversedText = cleanedText.split("").reverse().join("");
      return cleanedText === reversedText;
    }

    function createPalindromeChecker() {
      let lastCheckedText = "";

      return function check(text) {
        lastCheckedText = text;
        return isPalindrome(text);
      };
    }

    const checkPalindrome = createPalindromeChecker();
    const checkBtn = document.getElementById("checkBtn");
    const messageBox = document.getElementById("messageBox");

    checkBtn.addEventListener("click", () => {
      try {
        const inputText = document.getElementById("textInput").value;

        if (inputText.trim() === "") {
          throw new Error("Please enter some text.");
        }

        const result = checkPalindrome(inputText);
        const resultText = result ? "Yes! It is a palindrome." : "No, it is not a palindrome.";

        messageBox.className = "message success";
        messageBox.textContent = resultText;
      } catch (error) {
        messageBox.className = "message error";
        messageBox.textContent = error.message;
      }
    });
  </script>
</body>
</html>