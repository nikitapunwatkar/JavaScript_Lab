    </style>
</head>

<body>

<div class="container">

    <div class="header">
        <div>
            <h1>Gym Admission</h1>
            <p>JavaScript Form Validation</p>
        </div>

        <div class="student">
            Nikita Punwatkar<br>
            PRN: 24070521175
        </div>
    </div>


    <div class="form-card">

        <h2>Join Our Gym</h2>

        <form id="gymForm">

            <label>Full Name</label>
            <input type="text" id="name" placeholder="Enter your name">
            <div id="nameError" class="error"></div>


            <label>Email</label>
            <input type="text" id="email" placeholder="example@gmail.com">
            <div id="emailError" class="error"></div>


            <label>Phone Number</label>
            <input type="text" id="phone" placeholder="10-digit mobile number">
            <div id="phoneError" class="error"></div>


            <label>Age</label>
            <input type="number" id="age" placeholder="Enter your age">
            <div id="ageError" class="error"></div>


            <label>Membership Plan</label>
            <select id="plan">
                <option value="">Select a plan</option>
                <option>Monthly</option>
                <option>Quarterly</option>
                <option>Yearly</option>
            </select>
            <div id="planError" class="error"></div>


            <button type="submit">
                Submit Admission
            </button>

            <div id="success">
                ✓ Admission form submitted successfully!
            </div>

        </form>

    </div>

</div>


<script>

const fields = ["name", "email", "phone", "age", "plan"];


// Validation function
function validate(id) {

    const field = document.getElementById(id);
    const error = document.getElementById(id + "Error");
    const value = field.value.trim();

    let message = "";


    if (id === "name" && value.length < 3)
        message = "Name must contain at least 3 characters.";


    if (id === "email" &&
        !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value))
        message = "Enter a valid email address.";


    if (id === "phone" &&
        !/^[0-9]{10}$/.test(value))
        message = "Enter a valid 10-digit number.";


    if (id === "age" &&
        (value < 16 || value > 60))
        message = "Age must be between 16 and 60.";


    if (id === "plan" && value === "")
        message = "Please select a membership plan.";


    error.textContent = message;

    field.classList.toggle("invalid", message !== "");
    field.classList.toggle("valid", message === "" && value !== "");

    return message === "";
}


// Live validation using input event
fields.forEach(id => {

    document.getElementById(id).addEventListener(
        "input",
        () => validate(id)
    );

    document.getElementById(id).addEventListener(
        "change",
        () => validate(id)
    );

});


// Form submit event
document.getElementById("gymForm").addEventListener(
    "submit",
    function(event) {

        event.preventDefault();

        const valid =
            fields.every(id => validate(id));

        if (valid) {

            document.getElementById("success").style.display =
                "block";

            this.reset();

            fields.forEach(id => {
                document.getElementById(id)
                    .classList.remove("valid");
            });

        } else {

            document.getElementById("success").style.display =
                "none";
        }
    }
);

</script>

</body>
</html>
